# ─────────────────────────────────────────────────────────────
# VocaWeb API environment (apps/api). Copy to .env and fill in.
# The dashboard has its own template: apps/dashboard/.env.example
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/theo?sslmode=require
REDIS_URL=redis://localhost:6379

# --- Sign-in (Clerk) ---
# Create an application at https://dashboard.clerk.com and enable Google and GitHub
# under "SSO connections". The secret key is on the "API keys" page.
CLERK_SECRET_KEY=sk_test_PLACEHOLDER
# Optional. The PEM public key from the same page lets the API verify tokens offline.
CLERK_JWT_KEY=
# Optional. Comma-separated front-end origins allowed to call this API.
# Defaults to the CORS allow list (localhost, WEB_APP_URL, CORS_ALLOWED_ORIGINS).
CLERK_AUTHORIZED_PARTIES=

# --- AI (Vercel AI Gateway) ---
# One key for every model. Create it at https://vercel.com/dashboard/ai-gateway
# Builds spend the credit on this key, so keep it on the server only.
#   Website generation and edits  google/gemini-2.5-flash
#   Debugging and fixes           anthropic/claude-sonnet-4.6
#   Chat and planning             openai/gpt-5.5
#   Images                        openai/gpt-image-1
AI_GATEWAY_API_KEY=
# Builds and AI edits each account may run per UTC day. Defaults to 10.
FREE_DAILY_BUILDS=10

# --- Realtime voice (xAI, called directly) ---
XAI_API_KEY=

# --- Storage ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=theo-projects
R2_ENDPOINT=

# --- Publishing and CORS ---
# User sites publish as https://{slug}.DEPLOY_BASE_DOMAIN
VERCEL_TOKEN=
DEPLOY_BASE_DOMAIN=drooper.xyz
# Where the dashboard runs. Used for CORS and for redirects after connecting an integration.
WEB_APP_URL=http://localhost:3002
# Optional extra origins. *.vercel.app preview URLs are allowed automatically.
CORS_ALLOWED_ORIGINS=

# --- Integrations (Notion, Canva, Figma) ---
# OAuth callbacks hit the API, not the dashboard. Register these redirect URIs:
#   {INTEGRATIONS_CALLBACK_BASE}/api/integrations/notion/callback
#   {INTEGRATIONS_CALLBACK_BASE}/api/integrations/figma/callback
#   {INTEGRATIONS_CALLBACK_BASE}/api/integrations/canva/callback
INTEGRATIONS_CALLBACK_BASE=http://localhost:3001
INTEGRATION_TOKEN_SECRET=
INTEGRATIONS_MCP_ENABLED=true
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
CANVA_MCP_CLIENT_ID_URL=

# --- SDK access (optional) ---
# Comma-separated keys starting with dk_
VOCAWEB_SDK_API_KEYS=

# --- Observability and email (optional) ---
SENTRY_DSN=
RESEND_API_KEY=
