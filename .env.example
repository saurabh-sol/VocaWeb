# --- Core ---
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/theo?sslmode=require
REDIS_URL=redis://localhost:6379

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
CLERK_SECRET_KEY=sk_test_PLACEHOLDER
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- AI: Chat (Codex / gpt-5.5) ---
CODEX_API_KEY=
CODEX_BASE_URL=https://codex-everywhere.com
CODEX_MODEL=gpt-5.5

# --- AI: Website generation (Gemini) ---
GEMINI_API_KEY=
ANTIGRAVITY_API_KEY=

# --- AI: Debug / code fix (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MAX_API_KEY=

# --- AI: Voice conversation (xAI) ---
XAI_API_KEY=

# --- AI: Image generation (OpenAI) ---
OPENAI_API_KEY=

# --- Storage ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=theo-projects
R2_ENDPOINT=

# --- Deployment / CORS ---
# Deploy env vars (VERCEL_TOKEN, DEPLOY_BASE_DOMAIN) go on RENDER (API), not Vercel (web).
# User sites deploy as: https://{slug}.drooper.xyz
# Local:
#   NEXT_PUBLIC_API_URL=http://localhost:3001/api
#   NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel frontend + Render API):
#   NEXT_PUBLIC_API_URL=https://theo-api-oi9g.onrender.com/api
#   NEXT_PUBLIC_APP_URL=https://testing-web-sigma-five.vercel.app
#   CLERK_AUTHORIZED_PARTY=https://testing-web-sigma-five.vercel.app  (Render only)
#   CORS_ALLOWED_ORIGINS=  (optional; *.vercel.app preview URLs are allowed automatically)
VERCEL_TOKEN=
DEPLOY_BASE_DOMAIN=drooper.xyz
NEXT_PUBLIC_DEPLOY_BASE_DOMAIN=drooper.xyz
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLERK_AUTHORIZED_PARTY=
CORS_ALLOWED_ORIGINS=

# --- Billing (Post-MVP) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
METRONOME_API_KEY=

# --- Observability ---
SENTRY_DSN=

# --- Email ---
RESEND_API_KEY=

# --- Integrations (Notion, Canva, Figma OAuth — set on API / Render) ---
# Create integrations at notion.so/my-integrations, Canva Developer Portal, Figma OAuth app.
# OAuth callbacks hit the API (not the dashboard). Register these redirect URIs in each portal:
#   Notion: https://api.drooper.xyz/api/integrations/notion/callback
#   Figma:  https://api.drooper.xyz/api/integrations/figma/callback
#   Canva:  https://api.drooper.xyz/api/integrations/canva/callback
# After OAuth, users return to the dashboard (WEB_APP_URL).
INTEGRATIONS_CALLBACK_BASE=http://localhost:3001
WEB_APP_URL=http://localhost:3002
INTEGRATION_TOKEN_SECRET=
INTEGRATIONS_MCP_ENABLED=true
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
CANVA_MCP_CLIENT_ID_URL=
